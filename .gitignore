# Machine-local / recovery files: never publish.
.local-backups/
.codex/
.agents/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp
*.bak
*.log

# Secrets and local configuration. Templates must contain no real secret values.
.env
.env.*
!.env.example
*.local.*
secrets/
.secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.session

# Python / native / dependency build output.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
node_modules/
CMakeFiles/
CMakeCache.txt
*.o
*.obj
*.so
*.dll
*.exe

# Generated datasets and sensitive/heavy run artifacts.
/datasets/generated/
/datasets/oracle/
/datasets/raw/
/benchmarks/results/
/analysis/output/
/evidence/runs/
/infra/runtime/
*.dump
*.sql.gz
*.sqlite
*.sqlite3
*.db
*.zip
*.7z
*.tar
*.tar.gz

# Submission files are intentionally versioned only at canonical locations.
*.pdf
